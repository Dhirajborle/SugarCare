<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SugarCare"
            android:textColor="#8CE6B5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Daily Health Tracker"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todayDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B8C8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#1C2925"
            android:padding="16dp"
            android:text="Set your personal targets once to get started."
            android:textColor="#8CE6B5"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/targetPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1C2925"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/targetStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TARGET 1 OF 8"
                android:textColor="#8CE6B5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/targetProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="8"
                android:progress="1"
                android:progressTint="#8CE6B5" />

            <TextView
                android:id="@+id/targetQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="How much water do you aim to drink daily?"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/targetUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Litres per day"
                android:textColor="#B8C8C1"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/targetInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#8CE6B5"
                android:hint="Enter your target"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#899991" />

            <TextView
                android:id="@+id/targetTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Choose a target suitable for your needs."
                android:textColor="#B8C8C1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/nextTarget"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#8CE6B5"
                android:text="Next"
                android:textColor="#101615" />

            <Button
                android:id="@+id/backTarget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#293831"
                android:text="Back"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dailyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1C2925"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's Intake"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dailyStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ITEM 1 OF 8"
                android:textColor="#8CE6B5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/dailyStepProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="8"
                android:progress="1"
                android:progressTint="#8CE6B5" />

            <TextView
                android:id="@+id/dailyQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="How much water have you consumed today?"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dailyUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Litres"
                android:textColor="#B8C8C1"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/dailyInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#8CE6B5"
                android:hint="Enter amount consumed"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#899991" />

            <TextView
                android:id="@+id/dailyResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Your progress will appear here."
                android:textColor="#8CE6B5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/dailyProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#8CE6B5" />

            <Button
                android:id="@+id/nextDaily"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#8CE6B5"
                android:text="Next"
                android:textColor="#101615" />

            <Button
                android:id="@+id/backDaily"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#293831"
                android:text="Back"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/summaryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1C2925"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Summary"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#8CE6B5"
                android:textSize="15sp"
                android:lineSpacingExtra="8dp" />

            <Button
                android:id="@+id/editTargets"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#293831"
                android:text="Edit Targets"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/restartDaily"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#8CE6B5"
                android:text="Update Today's Intake"
                android:textColor="#101615" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:text="This tracker is for awareness only. Nutritional needs vary by person. Use appropriate guidance from a qualified healthcare professional for personal targets."
            android:textColor="#B8C8C1"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
