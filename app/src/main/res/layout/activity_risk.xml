<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SugarCare"
            android:textColor="#8CE6B5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Risk Awareness"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Answer these questions to learn about common type 2 diabetes risk factors."
            android:textColor="#B8C8C1"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. What is your age?"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/ageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/ageUnder35"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Below 35"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/age35to44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="35–44"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/age45plus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="45 or above"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. Do you have a parent or sibling with diabetes?"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/familyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/familyYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/familyNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/familyUnsure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unsure"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. Are you physically active on most days?"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/activityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/activityYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/activityNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/activitySometimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sometimes"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4. Have you ever been told by a healthcare professional that your blood glucose is high?"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/glucoseGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/glucoseYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/glucoseNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/glucoseUnsure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unsure"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <Button
            android:id="@+id/checkRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8CE6B5"
            android:text="View Awareness Result"
            android:textColor="#101615" />

        <TextView
            android:id="@+id/riskResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="18dp"
            android:textColor="#8CE6B5"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This educational questionnaire is not a validated risk calculator and cannot diagnose or rule out diabetes. Consult a healthcare professional for individual assessment."
            android:textColor="#B8C8C1"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
